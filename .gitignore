node_modules/

# Python-окружения: PaddleOCR и распознавание (torch)
.venv-ocr/
.venv-ml/
__pycache__/

# исходный датасет от организатора: архивы дампа uploads на 2+ ГБ
Датасет/

# секреты — никогда в репозиторий
.env
.env.*
!.env.example

# одноразовые раннеры миграций (коммитится сама миграция, не раннер)
scripts/apply-*.mjs

# локальные выгрузки и кеш
data/raw/
*.log

# фотографии прод-сканов: SCAN_ARCHIVE_DIR по умолчанию, относительно рабочего каталога API
data/scans/
platform/api/data/

# модели tesseract.js — качаются сами при первом запуске, десятки мегабайт
*.traineddata
