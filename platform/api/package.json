{
  "name": "@winvino/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "API распознавания вина по фото этикетки — один контракт для Mini App, бота, PWA и нативных клиентов",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.ts",
    "start": "node --env-file-if-exists=.env src/server.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "selftest:admin": "node --env-file-if-exists=../../.env --env-file-if-exists=.env scripts/selftest-admin-queue.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@winvino/contract": "*",
    "hono": "^4.13.8",
    "pg": "^8.16.3",
    "sharp": "^0.35.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/pg": "^8.23.1",
    "typescript": "~5.9.3",
    "vitest": "^5.0.1"
  }
}
