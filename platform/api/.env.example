# API распознавания. Всё необязательно — ниже значения по умолчанию.
# Копия в .env рядом (не коммитится) подхватывается командами dev/start.

# 0.0.0.0 — чтобы API был виден не только с этой машины (Docker, телефон в той же сети)
HOST=127.0.0.1
PORT=8787

# Origin браузерных клиентов через запятую или *. Боту и нативным приложениям CORS не нужен,
# веб ходит через свой прокси /api — ему тоже.
CORS_ORIGINS=*

# Какой распознаватель отвечает: mock — заглушка, model — сервис распознавания (scripts/serve-recognizer.mjs)
RECOGNIZER=mock
RECOGNIZE_TIMEOUT_MS=30000
MOCK_RECOGNIZER_DELAY_MS=700

# ── Только для RECOGNIZER=model ──
# Сервис распознавания и Postgres с каталогом (карточки вин). Для самоподписанного TLS — ?sslmode=no-verify
# RECOGNIZER_URL=http://127.0.0.1:8080
# DATABASE_URL=postgresql://user:password@host:5432/winvino
# CATALOG_REFRESH_MS=600000
# Пороги решения; значения по умолчанию выведены из eval-набора (src/recognizer/modelRecognizer.ts)
# MODEL_MATCHED_MIN_CONFIDENCE=0.8
# MODEL_NOT_IN_CATALOG_MAX_VISUAL=0.4
# MODEL_UNREADABLE_MAX_OCR_LETTERS=3
# MODEL_MAX_ALTERNATIVES=3

# ── Архив прод-сканов ──
# on — каждое распознавание сохраняется: фото файлом (имя — sha256 содержимого) и строка
# в label_scans с source=production. Нужен DATABASE_URL. Эталон проставляется потом руками.
# SCAN_ARCHIVE=off
# SCAN_ARCHIVE_DIR=./data/scans
# Чем получено предсказание — версия релиза модели; пусто — запишется имя распознавателя
# MATCHER_VERSION=siglip2-b16-ft1-e4

# JSON-строка на каждый запрос: requestId, метод, путь, статус, время
ACCESS_LOG=on
