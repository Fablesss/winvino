# Куда веб проксирует /api/*. Зашивается при сборке (next build): сменили — пересоберите.
# Это же значение читается в рантайме страницами /admin: они ходят в API с сервера, мимо прокси.
WINVINO_API_URL=http://127.0.0.1:8787

# Пароль раздела разметки /admin (не короче 12 символов). Должен совпадать с ADMIN_PASSWORD у API:
# им веб подписывает cookie сессии и им же представляется API. Пусто — раздела нет, /admin даёт 404.
ADMIN_PASSWORD=
