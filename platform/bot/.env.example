# Telegram-бот. Копия в .env рядом (не коммитится) подхватывается командами dev/start.

# Токен от @BotFather — обязателен. Для разработки заведите отдельного бота: два процесса
# с одним токеном мешают друг другу (getUpdates отвечает 409 Conflict).
TELEGRAM_BOT_TOKEN=

# API распознавания (npm run dev:api)
WINVINO_API_URL=http://127.0.0.1:8787

# HTTPS-адрес веба — кнопка «Открыть сканер» (Mini App). Не задан — кнопки нет.
# WEB_APP_URL=https://winvino.example.com

# Сколько секунд Telegram держит getUpdates, если апдейтов нет
# POLL_TIMEOUT_S=30

# Свой Bot API сервер или заглушка для проверки
# TELEGRAM_API_URL=https://api.telegram.org
