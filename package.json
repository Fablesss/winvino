{
  "name": "winvino",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Сканер этикеток российского вина: зеркало каталога vino-svoe.ru + матчер по OCR",
  "scripts": {
    "db:migrate": "node scripts/migrate.mjs",
    "db:status": "node scripts/migrate.mjs --status",
    "db:verify": "node scripts/db-verify.mjs",
    "catalog:sync": "node scripts/sync-catalog.mjs",
    "check:norm-parity": "node scripts/check-norm-parity.mjs",
    "selftest": "node scripts/selftest-catalog.mjs --workers 6",
    "selftest:report": "node scripts/report-selftest.mjs",
    "selftest:rematch": "node scripts/rematch-scans.mjs",
    "ocr:paddle:setup": "py -3.12 -m venv .venv-ocr && .venv-ocr\\Scripts\\python.exe -m pip install -r ocr/requirements.lock.txt",
    "ocr:paddle:pilot": "node scripts/paddle-pilot.mjs --n 20",
    "ocr:paddle:list": "node scripts/paddle-selftest.mjs list",
    "ocr:paddle:run": ".venv-ocr\\Scripts\\python.exe ocr/paddle_ocr.py --list data/raw/paddle-full/list.txt --out data/raw/paddle-full/result.jsonl",
    "ocr:paddle:ingest": "node scripts/paddle-selftest.mjs ingest",
    "dataset:manifest": "node scripts/build-dataset-manifest.mjs",
    "ml:setup": "py -3.12 -m venv .venv-ml && .venv-ml\\Scripts\\python.exe -m pip install -r ml/requirements.lock.txt --extra-index-url https://download.pytorch.org/whl/cu126",
    "ml:bench": ".venv-ml\\Scripts\\python.exe -m ml.bench_zeroshot",
    "ml:eval": ".venv-ml\\Scripts\\python.exe -m ml.eval_visual",
    "ml:train": ".venv-ml\\Scripts\\python.exe -u -m ml.train",
    "recognizer:eval": "node scripts/eval-recognizer.mjs",
    "serve:eval": "node scripts/serve-eval.mjs"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "pg": "^8.16.3",
    "sharp": "^0.35.4",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@sindresorhus/slugify": "^1.1.0"
  }
}
